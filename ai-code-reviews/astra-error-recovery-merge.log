   758	    /// Decompresses everything the decoder is set up to produce, asking for at most `chunk`
   759	    /// bytes per call.
   760	    fn decode_all<S: Seekable>(decoder: &mut Decoder<'_, S>, chunk: usize) -> Result<Vec<u8>> {
   761	        let mut output = vec![];
