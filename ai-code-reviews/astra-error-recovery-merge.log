    42	/// A seekable wrapper around a byte slice.
    43	#[derive(Debug, Clone)]
    44	pub struct BytesWrapper<'a> {
    45	    src: &'a [u8],
    46	    pos: usize,
    47	}
    48	
    49	impl<'a> BytesWrapper<'a> {
    50	    /// Returns a new `BytesWrapper` around the given slice.
    51	    pub fn new(src: &'a [u8]) -> Self {
    52	        Self { src, pos: 0 }
    53	    }
    54	}
    55	
    56	impl Seekable for BytesWrapper<'_> {
    57	    fn set_offset(&mut self, offset: OffsetFrom) -> Result<u64> {
    58	        let pos = match offset {
    59	            OffsetFrom::Start(pos) => usize::try_from(pos).ok(),
    60	            OffsetFrom::End(delta) => isize::try_from(delta)
    61	                .map(|d| self.src.len().checked_add_signed(d))
    62	                .ok()
    63	                .flatten(),
    64	        }
    65	        .ok_or(Error::offset_out_of_range())?;
    66	
    67	        if pos > self.src.len() {
    68	            return Err(Error::offset_out_of_range());
    69	        }
    70	
    71	        self.pos = pos;
    72	
    73	        Ok(pos as u64)
    74	    }
    75	
    76	    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
    77	        let len = buf.len().min(self.src.len() - self.pos);
    78	        buf[..len].copy_from_slice(&self.src[self.pos..self.pos + len]);
    79	        self.pos += len;
    80	
    81	        Ok(len)
    82	    }
    83	
    84	    fn seek_table_integrity(&mut self, format: Format) -> Result<[u8; SEEK_TABLE_INTEGRITY_SIZE]> {
    85	        let offset = match format {
    86	            Format::Head => (self.src.len() >= SKIPPABLE_HEADER_SIZE + SEEK_TABLE_INTEGRITY_SIZE)
    87	                .then_some(SKIPPABLE_HEADER_SIZE),
    88	            // Last 9 bytes
    89	            Format::Foot => self.src.len().checked_sub(SEEK_TABLE_INTEGRITY_SIZE),
    90	        }
    91	        .ok_or(Error::offset_out_of_range())?;
    92	
    93	        let mut buf = [0u8; SEEK_TABLE_INTEGRITY_SIZE];
    94	        buf.copy_from_slice(&self.src[offset..offset + SEEK_TABLE_INTEGRITY_SIZE]);
    95	
    96	        Ok(buf)
    97	    }
    98	}
