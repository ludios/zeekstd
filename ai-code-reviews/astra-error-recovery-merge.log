   580	/// Allows to set the offset of a `Decoder` via seeking.
    77	    pub fn decompress_into<'b: 'a, W: Write>(
    78	        mut self,
    79	        writer: &mut W,
    80	        prefix: Option<&'b [u8]>,
    81	    ) -> Result<u64> {
    82	        let mut buf = vec![0; DCtx::out_size()];
    83	        let mut buf_pos = 0;
    84	        let mut written = 0;
    85	
    86	        loop {
    87	            let n = self
    88	                .decoder
    89	                .decompress_with_prefix(&mut buf[buf_pos..], prefix)
    90	                .context("Failed to decompress data")?;
    91	            if n == 0 {
    92	                break;
    93	            }
    94	            if let Some(bar) = &self.bar {
    95	                bar.inc(n as u64);
    96	            }
    97	            buf_pos += n;
    98	            if buf_pos == buf.len() {
    99	                writer
   100	                    .write_all(&buf)
   101	                    .context("Failed to write decompressed data")?;
   102	                written += buf_pos as u64;
   103	                buf_pos = 0;
   104	            }
   105	        }
   106	
   107	        writer
   108	            .write_all(&buf[..buf_pos])
   109	            .context("Failed to write decompressed data")?;
   110	        written += buf_pos as u64;
   111	
   112	        if let Some(bar) = &self.bar {
   113	            bar.finish_and_clear();
   114	        }
   115	
   116	        Ok(written)
   117	    }
   118	}

