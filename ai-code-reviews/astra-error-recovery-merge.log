   278	    /// Creates a new `RawEncoder` with the given [`EncodeOptions`].
   279	    ///
   280	    /// # Errors
   281	    ///
   282	    /// Fails if the raw encoder could not be created.
   283	    pub fn with_opts(mut opts: EncodeOptions<'a>) -> Result<Self> {
   284	        if let FrameSizePolicy::Uncompressed(0) | FrameSizePolicy::Compressed(0) = opts.frame_policy
   285	        {
   286	            return Err(Error::invalid_frame_size_policy());
   287	        }
   288	
   289	        opts.cctx
   290	            .set_parameter(CParameter::CompressionLevel(opts.compression_level))?;
   291	        opts.cctx
   292	            .set_parameter(CParameter::ChecksumFlag(opts.checksum_flag))?;
   293	
   294	        Ok(Self {
   295	            cctx: opts.cctx,
   296	            frame_policy: opts.frame_policy,
   297	            frame_c_size: 0,
   298	            frame_d_size: 0,
   299	            seek_table: SeekTable::new(),
   300	        })
   301	    }
   302	
   303	    /// Performs a streaming compression step from `input` to `output`.
   304	    ///
   305	    /// Call this repetitively to consume the input stream. The returned [`CompressionProgress`]
   306	    /// indicates how many bytes were consumed from `input` and written to `output`. The caller
   307	    /// must check if `input` has been entirely consumed. If not, the caller must make some room
   308	    /// to receive more compressed data, and then present again remaining input data.
   309	    ///
   310	    /// If a `prefix` is passed, it will be re-applied to every frame, as tables are discarded at
   311	    /// end of frame. Referencing a prefix involves building tables, which is a CPU consuming
   312	    /// operation, with non-negligible impact on latency. This should be avoided for small frame
   313	    /// sizes. If there is a need to use the same prefix multiple times without long distance mode,
   314	    /// consider loading a dictionary into the compression context instead.
   315	    ///
   316	    /// # Errors
   317	    ///
   318	    /// If compression fails or any parameter is invalid.
   319	    pub fn compress_with_prefix<'b: 'a>(
   320	        &mut self,
   321	        input: &[u8],
   322	        output: &mut [u8],
   323	        prefix: Option<&'b [u8]>,
   324	    ) -> Result<CompressionProgress> {
   325	        if self.is_frame_complete() {
   326	            let mut out_progress = 0;
   327	            while out_progress < output.len() {
   328	                let progress = self.end_frame(&mut output[out_progress..])?;
   329	                out_progress += progress.out_progress;
   330	                if progress.data_left == 0 {
   331	                    break;
   332	                }
   333	            }
   334	
   335	            Ok(CompressionProgress::new(0, out_progress))
   336	        } else {
   337	            let limit = input.len().min(self.remaining_frame_size());
   338	            let mut in_buf = InBuffer::around(&input[..limit]);
   339	            let mut out_buf = OutBuffer::around(output);
   340	            // Reference prefix at the beginning of a frame
   341	            // TODO: chain when stable
   342	            if let Some(pref) = prefix {
   343	                if self.frame_d_size == 0 {
   344	                    self.cctx.ref_prefix(pref)?;
   345	                }
   346	            }
   347	
   348	            while in_buf.pos() < limit && out_buf.pos() < out_buf.capacity() {
   349	                self.cctx.compress_stream2(
   350	                    &mut out_buf,
   351	                    &mut in_buf,
   352	                    ZSTD_EndDirective::ZSTD_e_continue,
   353	                )?;
   354	            }
   355	
   356	            // Casting should always be fine
   357	            self.frame_c_size += out_buf.pos() as u32;
   358	            self.frame_d_size += in_buf.pos() as u32;
   359	
   360	            Ok(CompressionProgress::new(in_buf.pos(), out_buf.pos()))
   361	        }
   362	    }
   363	}
