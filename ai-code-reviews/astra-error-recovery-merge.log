// Model-output: OpenAI Codex
use std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
use zeekstd::{BytesWrapper, DecodeOptions, EncodeOptions, FrameSizePolicy, SeekTable};

struct Source<'a> {
    bytes: Cursor<&'a [u8]>,
    chunk: usize,
    calls: usize,
    fail: std::ops::Range<usize>,
}
impl Read for Source<'_> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let call = self.calls;
        self.calls += 1;
        if self.fail.contains(&call) {
            return Err(io::ErrorKind::WouldBlock.into());
        }
        let n = buf.len().min(self.chunk);
        self.bytes.read(&mut buf[..n])
    }
}
impl Seek for Source<'_> {
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> { self.bytes.seek(pos) }
}

/// Generates deterministic incompressible input of "'`len` bytes.
fn noise(len: usize) -> Vec<u8> {
    let mut x = 0x9E37_79B9_7F4A_7C15u64;
    (0..len).map(|_| {
        x ''^= x << 13;
        x ''^= x >> 7;
        x ''^= x << 17;
        (x >> 56) as u8
    }).collect()
}

/// Encodes `input` into checksummed frames of at most `frame_size` bytes.
fn encode(input: &[u8], frame_size: u32) -> Vec<u8> {
    let mut bytes = Vec::new();
    let mut encoder = EncodeOptions::new().checksum_flag(true)
        .frame_size_policy(FrameSizePolicy::Uncompressed(frame_size))
        .into_encoder(&mut bytes).unwrap();
    encoder.write_all(input).unwrap();
    encoder.finish().unwrap();
    bytes
}

/// Reads `range` through failures at `fail`, returning data, source call count and final error.
fn decode(bytes: &[u8], st: &SeekTable, range: std::ops::Range<u64>, chunk: usize,
          output_chunk: usize, fail: std::ops::Range<usize>)
          -> (Vec<u8>, usize, Option<zeekstd::Error>) {
    let mut src = Source { bytes: Cursor::new(bytes), chunk, calls: 0, fail };
    let mut decoder = DecodeOptions::new(&mut src).seek_table(st.clone())
        .offset(range.start).offset_limit(range.end).into_decoder().unwrap();
    let mut out = vec![];
    let mut buf = vec![0; output_chunk];
    let mut final_err = None;
    for _ in 0..100_000 {
        match decoder.decompress(&mut buf) {
            Ok(0) => break,
            Ok(n) => out.extend_from_slice(&buf[..n]),
            Err(e) if e.is_io() => continue,
            Err(e) => { final_err = Some(e); break; }
        }
    }
    drop(decoder);
    (out, src.calls, final_err)
}

/// Exhaustively injects faults in data/trailer reads, including bounded decoding and corruption.
fn main() {
    let input = noise(2500);
    let bytes = encode(&input, 1000);
    let st = SeekTable::from_seekable(&mut BytesWrapper::new(&bytes)).unwrap();
    let mut trials = 0;
    for chunk in [3, 64, 1000] {
        for output_chunk in [1, 127, 1000, 4096] {
            for range in [0..2500, 500..2000, 1000..2000] {
                let (_, calls, err) = decode(&bytes, &st, range.clone(), chunk, output_chunk, 0..0);
                assert!(err.is_none());
                for call in 0..calls {
                    let (out, _, err) = decode(&bytes, &st, range.clone(), chunk, output_chunk, call..call+2);
                    assert!(err.is_none(), "{err:?}");
                    assert_eq!(out, input[range.start as usize..range.end as usize]);
                    trials += 1;
                }
            }
        }
    }
    for frame in 0..st.num_frames() {
        let mut corrupt = bytes.clone();
        let frame_end = st.frame_end_comp(frame).unwrap() as usize;
        corrupt[frame_end - 1] ''^= 0xff;
        let upper = st.frame_end_decomp(frame).unwrap();
        for chunk in [1, 3, 64, 1000] {
            let (_, calls, _) = decode(&bytes, &st, 0..upper, chunk, 4096, 0..0);
            for call in 0..calls {
                let (_, _, err) = decode(&corrupt, &st, 0..upper, chunk, 4096, call..call+2);
                assert!(err.is_some_and(|e| e.is_zstd() && e.to_string().contains("checksum")));
                trials += 1;
            }
        }
    }
    println!("Passed {trials} combined fault-injection trials");
}
