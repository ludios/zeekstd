   112	#[cfg(feature = "std")]
   113	impl<T> Seekable for T
   114	where
   115	    T: std::io::Read + std::io::Seek,
   116	{
   117	    fn set_offset(&mut self, offset: OffsetFrom) -> Result<u64> {
   118	        Ok(self.seek(offset.into())?)
   119	    }
   120	
   121	    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
   122	        // A caller of `Seekable` cannot tell an interruption from a failure, so retry it here, as
   123	        // `read_exact` does
   124	        loop {
   125	            match std::io::Read::read(self, buf) {
   126	                Err(err) if err.kind() == std::io::ErrorKind::Interrupted => {}
   127	                res => return Ok(res?),
   128	            }
   129	        }
   130	    }
   131	
   132	    fn seek_table_integrity(&mut self, format: Format) -> Result<[u8; SEEK_TABLE_INTEGRITY_SIZE]> {
   133	        match format {
   134	            Format::Head => self.seek(std::io::SeekFrom::Start(SKIPPABLE_HEADER_SIZE as u64))?,
   135	            // Last 9 bytes
   136	            Format::Foot => {
   137	                self.seek(std::io::SeekFrom::End(-(SEEK_TABLE_INTEGRITY_SIZE as i64)))?
   138	            }
   139	        };
   140	
   141	        let mut buf = [0u8; SEEK_TABLE_INTEGRITY_SIZE];
   142	        self.read_exact(&mut buf)?;
   143	
   144	        Ok(buf)
   145	    }
   146	}
