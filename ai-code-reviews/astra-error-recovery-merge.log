   645	    /// end of frame. Referencing a prefix involves building tables, which is a CPU consuming
   646	    /// operation, with non-negligible impact on latency. This should be avoided for small frame
   647	    /// sizes. If there is a need to use the same prefix multiple times without long distance mode,
   648	    /// consider loading a dictionary into the compression context instead.
   649	    ///
   650	    /// # Errors
   651	    ///
   652	    /// If compression fails or any parameter is invalid.
   653	    pub fn compress_with_prefix<'b: 'a>(
   654	        &mut self,
   655	        buf: &[u8],
   656	        prefix: Option<&'b [u8]>,
   657	    ) -> Result<usize> {
