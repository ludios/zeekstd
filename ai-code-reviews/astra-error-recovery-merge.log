   410	    /// Ends the current frame and adds it to the seek table.
   411	    ///
   412	    /// Call this repetitively to write the frame epilogue to `output`. The Encoder terminates
   413	    /// frames during compression automatically according to the configured [`FrameSizePolicy`].
   414	    /// Additionally this function can be used to end frames manually at any time during
   415	    /// compression, however, you always need to end the last frame manually.
   416	    ///
   417	    /// The returned [`EpilogueProgress`] indicates how many bytes were written to `output` and
   418	    /// provides a minimal estimation of how many bytes are left to flush. Should be called until
   419	    /// no more bytes are left to flush.
   420	    ///
   421	    /// # Errors
   422	    ///
   423	    /// Fails if the frame epilogue cannot be written or the frame limit is reached.
   424	    ///
   425	    /// # Examples
   426	    ///
   427	    /// ```
   428	    /// use zeekstd::RawEncoder;
   429	    ///
   430	    /// let mut encoder = RawEncoder::new()?;
   431	    /// let mut output: Vec<u8> = vec![];
   432	    /// let mut in_progress = 0;
   433	    /// let mut buf = [0u8; 128];
   434	    ///
   435	    /// // Compress input data...
   436	    ///
   437	    /// loop {
   438	    ///     let prog = encoder.end_frame(&mut buf)?;
   439	    ///     output.extend(&buf[..prog.out_progress()]);
   440	    ///     if prog.data_left() == 0 {
   441	    ///         break;
   442	    ///     }
   443	    /// }
   444	    /// # Ok::<(), zeekstd::Error>(())
   445	    /// ```
   446	    pub fn end_frame(&mut self, output: &mut [u8]) -> Result<EpilogueProgress> {
   447	        let mut empty_buf = InBuffer::around(&[]);
   448	        let mut out_buf = OutBuffer::around(output);
   449	
   450	        loop {
   451	            let prev_out_pos = out_buf.pos();
   452	            let n = self.cctx.compress_stream2(
   453	                &mut out_buf,
   454	                &mut empty_buf,
   455	                ZSTD_EndDirective::ZSTD_e_end,
   456	            )?;
   457	
   458	            // Casting should always be fine
   459	            self.frame_c_size += (out_buf.pos() - prev_out_pos) as u32;
   460	
   461	            // Check first if writing the frame epilogue finished before checking whether the out
   462	            // buffer is full. Changing the order leads to frames not beeing logged when the frame
   463	            // epilogue fits exactly in the buffer.
   464	            if n == 0 {
   465	                break;
   466	            }
   467	
   468	            if out_buf.pos() == out_buf.capacity() {
   469	                // Indicate that more buffer space is required
   470	                return Ok(EpilogueProgress::new(out_buf.pos(), n));
   471	            }
   472	        }
   473	
   474	        self.seek_table
   475	            .log_frame(self.frame_c_size, self.frame_d_size)?;
   476	        self.reset_frame();
   477	
   478	        // If we get here the frame is complete
   479	        Ok(EpilogueProgress::new(out_buf.pos(), 0))
   480	    }
