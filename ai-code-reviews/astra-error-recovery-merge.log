   670	    /// Compresses `input` into a complete seekable (frames followed by a `Foot` seek table),
   671	    /// checking that the encoder's progress reports add up to what it wrote.
   672	    fn encode(input: &[u8], frame_size_policy: Option<FrameSizePolicy>, checksum: bool) -> Vec<u8> {
   673	        let mut seekable = vec![];
   674	        let mut encoder = EncodeOptions::new()
   675	            .frame_size_policy(frame_size_policy.unwrap_or_default())
   676	            .checksum_flag(checksum)
   677	            .into_raw_encoder()
   678	            .unwrap();
   679	
   680	        let mut buf = vec![0; input.len().max(64)];
   681	
   682	        let mut in_progress = 0;
   683	        let mut out_progress = 0;
   684	        while in_progress < input.len() {
   685	            let progress = encoder.compress(&input[in_progress..], &mut buf).unwrap();
   686	            seekable.extend(&buf[..progress.out_progress()]);
   687	            in_progress += progress.in_progress();
   688	            out_progress += progress.out_progress();
   689	        }
   690	        assert_eq!(in_progress, input.len());
   691	
   692	        loop {
   693	            let prog = encoder.end_frame(&mut buf).unwrap();
   694	            seekable.extend(&buf[..prog.out_progress()]);
   695	            out_progress += prog.out_progress();
   696	            if prog.data_left() == 0 {
   697	                break;
   698	            }
   699	        }
   700	        assert_eq!(out_progress, seekable.len());
   701	
   702	        let mut ser = encoder.into_seek_table().into_serializer();
   703	        loop {
   704	            let n = ser.write_into(&mut buf);
   705	            if n == 0 {
   706	                break;
   707	            }
   708	            seekable.extend(&buf[..n]);
   709	        }
   710	        assert_eq!(out_progress + ser.encoded_len(), seekable.len());
   711	
   712	        seekable
   713	    }
