   323	/// the trailer of its current frame, which ends at `frame_end` (`None` past the last frame).
   324	/// `frame_done` tells whether the context is between frames.
   325	fn trailer_pending(frame_done: bool, frame_end: Option<u64>, pos: u64) -> bool {
   326	    !frame_done && frame_end == Some(pos)
