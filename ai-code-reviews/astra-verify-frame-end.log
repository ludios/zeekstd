   341	    /// ```
   342	    /// # use zeekstd::{BytesWrapper, RawEncoder};
   343	    /// # let mut encoder = RawEncoder::new()?;
   344	    /// # let mut seekable = [0u8; 128];
   345	    /// # let prog = encoder.compress(b"Hello, World!", &mut seekable)?;
   346	    /// # let end_prog = encoder.end_frame(&mut seekable[prog.out_progress()..])?;
   347	    /// # let mut ser = encoder.into_seek_table().into_serializer();
   348	    /// # let mut n = prog.out_progress() + end_prog.out_progress();
   349	    /// # n += ser.write_into(&mut seekable[n..]);
   350	    /// # let seekable = BytesWrapper::new(&seekable[..n]);
   351	    /// use zeekstd::Decoder;
   352	    ///
   353	    /// let mut decoder = Decoder::new(seekable)?;
   354	    /// // Make sure `buf` is big enough to hold all decompressed data
   355	    /// let mut buf = [0u8; 128];
   356	    /// let mut progress = 0;
   357	    ///
   358	    /// // Decompress in a loop until no more bytes are written to `buf`
   359	    /// loop {
   360	    ///     let n = decoder.decompress(&mut buf[progress..])?;
   361	    ///     if n == 0 {
   362	    ///         break;
   363	    ///     }
   364	    ///     progress += n;
   365	    /// }
   366	    ///
   367	    /// # assert_eq!(b"Hello, World!", &buf[..progress]);
   368	    /// # Ok::<(), zeekstd::Error>(())
   369	    /// ```
   370	    pub fn decompress(&mut self, buf: &mut [u8]) -> Result<usize> {
   371	        self.decompress_with_prefix(buf, None)
   372	    }
   373	
   374	    /// Resets the current decompresion status.
   375	    ///
   376	    /// This resets the internal decompression context as well as decompression offset and limit.
   377	    /// The next decompression operation after this function will start from the beginning of the
   378	    /// seekable source.
   379	    ///
   380	    /// # Examples
   381	    ///
   382	    /// ```
   383	    /// # use zeekstd::{BytesWrapper, RawEncoder};
   384	    /// # let mut encoder = RawEncoder::new()?;
   385	    /// # let mut seekable = [0u8; 128];
   386	    /// # let prog = encoder.compress(b"Hello, World!", &mut seekable)?;
   387	    /// # let end_prog = encoder.end_frame(&mut seekable[prog.out_progress()..])?;
   388	    /// # let mut ser = encoder.into_seek_table().into_serializer();
   389	    /// # let mut n = prog.out_progress() + end_prog.out_progress();
   390	    /// # n += ser.write_into(&mut seekable[n..]);
   391	    /// # let seekable = BytesWrapper::new(&seekable[..n]);
   392	    /// use zeekstd::Decoder;
   393	    ///
   394	    /// let mut decoder = Decoder::new(seekable)?;
   395	    /// decoder.reset();
   396	    ///
   397	    /// assert_eq!(decoder.read_compressed(), 0);
   398	    /// assert_eq!(decoder.offset(), 0);
   399	    /// assert_eq!(decoder.offset_limit(), decoder.seek_table().size_decomp());
   400	    /// # Ok::<(), zeekstd::Error>(())
   401	    /// ```
   402	    pub fn reset(&mut self) {
   403	        self.reset_dctx();
   404	        self.offset = 0;
   405	        self.offset_limit = self.seek_table().size_decomp();
   406	    }
   407	
   408	    fn reset_dctx(&mut self) {
   409	        self.read_compressed = 0;
   410	        self.frame_done = true;
   411	        self.dctx
   412	            .reset(ResetDirective::SessionOnly)
   413	            .expect("Resetting session never fails");
   414	    }
   415	
   416	    /// Sets the decompression offset to the beginning of the frame at `index`.
   417	    ///
   418	    /// This has the same effect as calling [`Self::set_offset`] with the decompressed start
   419	    /// position of the frame at `index`.
   420	    ///
   421	    /// # Errors
   422	    ///
   423	    /// When the the passed frame index is out of range.
   424	    pub fn set_lower_frame(&mut self, index: u32) -> Result<u64> {
   425	        let offset = self.seek_table.frame_start_decomp(index)?;
   426	        self.set_offset(offset)?;
   427	
   428	        Ok(offset)
   429	    }
