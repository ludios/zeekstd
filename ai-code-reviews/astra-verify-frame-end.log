    ///
    /// assert_eq!(1, seek_table.num_frames());
    /// # Ok::<(), zeekstd::Error>(())
    /// ```
    pub fn num_frames(&self) -> u32 {
        // Cast is always possible (max value SEEKABLE_MAX_FRAMES)
        (self.entries.0.len() - 1) as u32
    }

