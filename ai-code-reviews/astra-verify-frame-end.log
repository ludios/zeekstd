[workspace]
resolver = "2"
members = ["cli", "lib", "fuzz"]

[workspace.package]
edition = "2024"
license = "BSD-2-Clause"
description = "Rust implementation of the Zstandard Seekable Format."
homepage = "https://github.com/rorosen/zeekstd"
repository = "https://github.com/rorosen/zeekstd"
readme = "README.md"
keywords = ["zstd", "zstandard", "compression", "zstd-seekable-format"]
categories = ["compression"]

[workspace.dependencies]
zstd-safe = { version = "7.2.4", features = ["std"] }

[workspace.lints.clippy]
pedantic = { level = "deny", priority = -1 }
cast_possible_wrap = "allow"
cast_possible_truncation = "allow"
cast-lossless = "allow"
must_use_candidate = "allow"
return_self_not_must_use = "allow"
struct-excessive-bools = "allow"

[profile.bench]
codegen-units = 1
opt-level = 3
[package]
name = "zeekstd"
version = "0.6.2"
description.workspace = true
edition.workspace = true
license.workspace = true
keywords.workspace = true
categories.workspace = true
homepage.workspace = true
repository.workspace = true
readme.workspace = true

[dependencies]
zstd-safe = { workspace = true }

[dev-dependencies]
criterion = "0.8.1"
proptest = "1.9.0"
zstd = "0.13.3"

[dev-dependencies.zstd-safe]
workspace = true
features = ["seekable"]

[features]
default = ["std"]

std = ["zstd-safe/std"]

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[lints]
workspace = true

[[bench]]
name = "compress"
harness = false

[[bench]]
name = "decompress"
harness = false

