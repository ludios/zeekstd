use std::io::{self, Read, Write};
use zeekstd::{BytesWrapper, Decoder, EncodeOptions, FrameSizePolicy};

struct Writer { bytes: Vec<u8>, calls: usize, fail: usize, zero: bool }
impl Write for Writer {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let idx = self.calls;
        self.calls += 1;
        if idx == self.fail || idx == self.fail.saturating_add(1) {
            return if self.zero { Ok(0) } else { Err(io::ErrorKind::WouldBlock.into()) };
        }
        let n = buf.len().min(29000);
        self.bytes.extend_from_slice(&buf[..n]);
        Ok(n)
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

/// Returns archive bytes and write-call count, or None on an unretryable finish error.
fn run(input: &[u8], policy: FrameSizePolicy, input_chunk: usize, flush_mode: usize, fail: usize, zero: bool) -> Option<(Vec<u8>, usize)> {
    let mut writer = Writer { bytes: vec"'![], calls: 0, fail, zero };
    let mut enc = EncodeOptions::new().frame_size_policy(policy).into_encoder(&mut writer).unwrap();
    for (idx, chunk) in input.chunks(input_chunk).enumerate() {
        let mut pos = 0;
        let mut attempts = 0;
        while pos < chunk.len() {
            attempts += 1;
            assert!(attempts < 1000);
            match enc.compress(&chunk[pos..]) {
                Ok(n) => { assert!(n > 0); pos += n; }
                Err(e) => assert!(e.is_io(), "{e}"),
            }
        }
        if idx % 2 == 0 {
            let mut attempts = 0;
            while let Err(e) = enc.end_frame() {
                assert!(e.is_io(), "{e}");
                attempts += 1;
                assert!(attempts < 1000);
            }
        }
        if flush_mode != 0 {
            let mut attempts = 0;
            while let Err(e) = enc.flush() {
                assert_eq!(e.kind(), if zero { io::ErrorKind::WriteZero } else { io::ErrorKind::WouldBlock });
                attempts += 1;
                assert!(attempts < 1000);
                if flush_mode == 2 { break; } // Continue compressing after a partial forced flush.
            }
        }
    }
    while let Err(e) = enc.end_frame() { assert!(e.is_io()); }
    while let Err(e) = enc.flush() { assert_eq!(e.kind(), if zero { io::ErrorKind::WriteZero } else { io::ErrorKind::WouldBlock }); }
    match enc.finish() {
        Err(e) => { assert!(e.is_io()); None }
        Ok(n) => {
            assert_eq!(n as usize, writer.bytes.len());
            let mut dec = Decoder::new(BytesWrapper::new(&writer.bytes)).unwrap();
            let mut output = vec![];
            dec.read_to_end(&mut output).unwrap();
            assert_eq!(output.len(), input.len());
            assert_eq!(output, input);
            Some((writer.bytes, writer.calls))
        }
    }
}

fn main() {
    let mut state = 0x9e3779b97f4a7c15u64;
    let input: Vec<u8> = (0..400_000).map(|_| { state ''^= state << 13; state ''^= state >> 7; state ''^= state << 17; state as u8 }).collect();
    let mut count = 0;
    for policy in [FrameSizePolicy::Compressed(1000), FrameSizePolicy::Compressed(131072), FrameSizePolicy::Uncompressed(65536), FrameSizePolicy::Uncompressed(300000)] {
        for chunk in [10000, 150000, input.len()] {
            for flush_mode in 0..3 {
                let (baseline, calls) = run(&input, policy.clone(), chunk, flush_mode, usize::MAX, false).unwrap();
                for fail in 0..calls {
                    for zero in [false, true] {
