                            assert_eq!(bytes, baseline, "different frame data: policy={policy:?} chunk={chunk} flush_mode={flush_mode} fail={fail} zero={zero}");
                        }
                        count += 1;
                    }
                }
            }
        }
    }
    println!("{count} additional fault-injection trials passed");
}
